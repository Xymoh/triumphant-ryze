# ---- Discord (https://discord.com/developers/applications) ----
DISCORD_TOKEN=
# Application ID, from the "General Information" page
CLIENT_ID=
# Optional: a test server ID. `npm run deploy -- --guild` registers commands there instantly.
DEV_GUILD_ID=

# ---- Riot Games (https://developer.riotgames.com) ----
RIOT_API_KEY=

# ---- Database ----
# Postgres connection string. Leave empty to use a local SQLite file (data/bot.sqlite).
# Example for the old local setup: postgres://postgres:admin@localhost:5433/triumphantRyzeDB
DATABASE_URL=
# "true" to require TLS (most hosted databases), "no-verify" for hosts with self-signed certificates
DATABASE_SSL=

# ---- Optional tuning ----
# MAX_PLAYERS_PER_GUILD=50
# RANK_CACHE_SECONDS=120

# ---- Optional links shown in /help ----
# WEBSITE_URL=https://example.com
# SUPPORT_SERVER_URL=https://discord.gg/your-invite

# ---- Docker Compose only: password for the bundled Postgres container ----
# POSTGRES_PASSWORD=
