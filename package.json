{
  "name": "triumphant-ryze-discord-bot",
  "version": "2.0.0",
  "description": "Discord bot that tracks League of Legends ranks for a group of friends and shows who is on top.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "emojis": "node scripts/upload-rank-emojis.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "discord",
    "bot",
    "league-of-legends",
    "riot-api",
    "leaderboard"
  ],
  "author": "Xymoh",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.27.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
